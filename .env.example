# Copy to .env, set an absolute state directory outside this checkout.
MUDFUT_STATE_DIR=/absolute/private/community-bot-state

# Which model answers. Any provider your local Letta runtime can authenticate:
#   chatgpt-plus-pro/gpt-6-sol          ChatGPT subscription login
#   lc-anthropic/claude-...            Anthropic API key or Claude subscription
#   openai/gpt-...                     OpenAI API key
#   openai-compatible/<model>          Any OpenAI-compatible endpoint
#   ollama/<model>                     Local Ollama
#   lc-gemini/..., openrouter/..., groq/..., xai/..., amazon-bedrock/...
# Run `letta connect <provider>` with LETTA_LOCAL_BACKEND_DIR pointing at
# "$MUDFUT_STATE_DIR/letta" to store a credential, or export the provider's
# usual API-key variable (OPENAI_API_KEY, ANTHROPIC_API_KEY, GEMINI_API_KEY, ...).
MUDFUT_MODEL=chatgpt-plus-pro/gpt-6-sol

# letta = use the local provider store and/or provider API-key variables (default).
# codex-snapshot = copy one short-lived ChatGPT token from ~/.codex/auth.json;
# fictional model proof only, not unattended operation, ChatGPT models only.
MUDFUT_AUTH_MODE=letta

# Set to 0 to start without checking that the configured provider has credentials.
# Not recommended: failures then surface mid-turn instead of at startup.
# MUDFUT_REQUIRE_CREDENTIALS=0

# Optional absolute path to an operator-owned style file (1–8,000 bytes).
# MUDFUT_PERSONA_STYLE_FILE=/absolute/private/community-style.md
# Optional path to PostgreSQL 16 server binaries for fixture checks.
# MUDFUT_PG_BIN=/path/to/postgresql-16/bin
